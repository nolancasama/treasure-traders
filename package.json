{
  "name": "treasure-traders",
  "private": true,
  "version": "0.1.0",
  "description": "Treasure Traders: The School Festival Quest - a 3D adventure where \"Do you have a ___?\" is how you trade, help and solve puzzles (Japanese grade 4).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:short": "npm run build && playwright test --project=chromebook-short",
    "e2e:campaign": "npm run build && playwright test --project=chromebook-mic-free --project=chromebook-speech",
    "shots": "npm run build && playwright test --config=playwright.shots.config.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
